{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'static site - no build needed'",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "cleanUrls": true,
  "functions": {
    "api/*.js": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/", "destination": "/map.html" }
  ]
}
